
{
  "name": "Tavern.exe Development",

  "image": "mcr.microsoft.com/devcontainers/universal:2",

  "postCreateCommand": "python3 -m pip install --user supervisor==4.3.0 && cd client && npm ci",

  "postStartCommand": "python3 -m supervisor.supervisord -c .devcontainer/supervisord.conf",
  
  "waitFor": "postCreateCommand",

  "forwardPorts": [5173, 3000],

  "portsAttributes": {
    "5173": {
      "label": "Tavern.exe Frontend",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "3000": {
      "label": "Tavern.exe API",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
